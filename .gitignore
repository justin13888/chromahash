# === Node ===
node_modules/
dist/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.local
.env.*.local

# Local-only Maven Central signing material (just android-gen-signing-key) — NEVER commit.
signing-key.asc
signing-password.txt

# === Rust ===
rust/target/
tools/thumbhash-rs/target/
**/*.rs.bk
Cargo.lock

# === Gradle / Kotlin ===
kotlin/.gradle/
kotlin/build/
kotlin/out/
*.class
*.jar
!kotlin/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.gradle/
build/

# === Swift / SPM ===
swift/.build/
swift/.swiftpm/
swift/*.xcodeproj
swift/DerivedData/
*.xcworkspace
*.xcuserstate
Packages/

# === Linux ===
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# === Python ===
__pycache__/
*.py[cod]
*.pyo
python/.venv/
python/*.egg-info/
python/dist/

# === C# / .NET ===
csharp/**/bin/
csharp/**/obj/
csharp/*.user
*.suo
*.userosscache
*.sln.docstates

# === Comparison tool ===
tools/comparison/output/
tools/comparison/fixtures/synthetic/
tools/comparison/fixtures/natural/

# === C binding (chromahash-c) ===
bindings/c/target/
# NOTE: bindings/c/include/chromahash.h is a COMMITTED generated artifact (CI
# diffs it to catch drift) — it is intentionally NOT ignored.

# === WASM binding (chromahash-wasm) ===
bindings/wasm/target/
# wasm-pack output (.wasm + JS glue + .d.ts) — regenerated by `just build-wasm`.
bindings/wasm/pkg*/

# === Android binding ===
bindings/uniffi/target/
bindings/uniffi/android/.gradle/
bindings/uniffi/android/.kotlin/
bindings/uniffi/android/build/
# Build outputs regenerated by cargo-ndk + uniffi-bindgen — never committed.
bindings/uniffi/android/src/main/jniLibs/
bindings/uniffi/android/src/main/kotlin/
# The root `*.jar` rule above would otherwise swallow the wrapper jar.
!bindings/uniffi/android/gradle/wrapper/gradle-wrapper.jar

# === Editors ===
.vscode/
.idea/
*.iml
.todos/
go/encode-stdin
# Go cgo build inputs staged from chromahash-c by `just go-cbuild`.
go/lib/
go/include/
