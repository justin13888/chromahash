# Only repo-wide, implementation-agnostic ignores live here. Each implementation
# keeps its own build/tooling ignores in its directory's .gitignore
# (rust/, bindings/*/, typescript/, swift/, go/, python/, csharp/, tools/*/).

# Local-only Maven Central signing material (mise run android:gen-signing-key) —
# generated at the repo root; NEVER commit.
signing-key.asc
signing-password.txt

# SwiftPM writes its build outputs beside the manifest, and Package.swift must
# live at the repo root for SwiftPM and the Swift Package Index to resolve the
# package (see the note in Package.swift). Anchored so the per-directory
# .gitignore files still own everything below the root.
/.build/
/.swiftpm/

# === Linux ===
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# === Editors ===
.vscode/
.idea/
*.iml
.todos/

# Python bytecode caches (tools/benchmark, spec/).
__pycache__/
*.py[cod]
